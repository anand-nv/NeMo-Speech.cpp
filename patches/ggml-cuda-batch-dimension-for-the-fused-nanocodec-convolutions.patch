+// Batched form of the half-snake pattern (NanoCodec's batched streaming decode): x is [T, C, B],
+// so its channel slices are strided and the graph makes them contiguous first:
+//   x_snake = CONT(VIEW(x)) [node i-1] -> mul, sin, sqr, mul, add [i .. i+4]
+//   VIEW(x) [i+5] -> CONT [i+6] -> leaky_relu [i+7] -> concat [i+8]
+// The fused kernel reads the computed x_snake and the leaky-ReLU slice straight from the view,
+// with exactly the per-element arithmetic of the unbatched fusion. Returns the nodes to skip.
+static int ggml_cuda_try_fuse_half_snake_batched(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, int i) {
+    if (i <= 0 || i + 8 >= cgraph->n_nodes) {
+        return 0;
+    }
+    ggml_tensor * mul0   = cgraph->nodes[i + 0];
+    ggml_tensor * sin    = cgraph->nodes[i + 1];
+    ggml_tensor * sqr    = cgraph->nodes[i + 2];
+    ggml_tensor * mul1   = cgraph->nodes[i + 3];
+    ggml_tensor * add    = cgraph->nodes[i + 4];
+    ggml_tensor * view_l = cgraph->nodes[i + 5];
+    ggml_tensor * cont_l = cgraph->nodes[i + 6];
+    ggml_tensor * lrelu  = cgraph->nodes[i + 7];
+    ggml_tensor * concat = cgraph->nodes[i + 8];
+    if (mul0->op != GGML_OP_MUL || sin->op != GGML_OP_SIN || sqr->op != GGML_OP_SQR ||
+        mul1->op != GGML_OP_MUL || add->op != GGML_OP_ADD || view_l->op != GGML_OP_VIEW ||
+        cont_l->op != GGML_OP_CONT || lrelu->op != GGML_OP_LEAKY_RELU || concat->op != GGML_OP_CONCAT) {
+        return 0;
+    }
+    for (int k = 0; k <= 7; ++k) {
+        if (!ggml_cuda_node_can_be_elided(cgraph, i + k, 1)) {
+            return 0;
+        }
+    }
+    const ggml_tensor * x_snake = ggml_are_same_shape(mul0, mul0->src[0]) ? mul0->src[0] : mul0->src[1];
+    const ggml_tensor * alpha   = (x_snake == mul0->src[0]) ? mul0->src[1] : mul0->src[0];
+    if (x_snake->op != GGML_OP_CONT || x_snake != cgraph->nodes[i - 1] || x_snake->src[0]->op != GGML_OP_VIEW) {
+        return 0;
+    }
+    const ggml_tensor * inv_b = (mul1->src[0] == sqr) ? mul1->src[1] : mul1->src[0];
+    const ggml_tensor * x_in_add = (add->src[0] == mul1) ? add->src[1] : add->src[0];
+    if (sin->src[0] != mul0 || sqr->src[0] != sin || (mul1->src[0] != sqr && mul1->src[1] != sqr) ||
+        x_in_add != x_snake || cont_l->src[0] != view_l || lrelu->src[0] != cont_l ||
+        concat->src[0] != add || concat->src[1] != lrelu) {
+        return 0;
+    }
+    const int32_t concat_dim = ((const int32_t *) concat->op_params)[0];
+    const bool shape_ok = x_snake->type == GGML_TYPE_F32 && view_l->type == GGML_TYPE_F32 &&
+                          concat->type == GGML_TYPE_F32 && concat_dim == 1 &&
+                          x_snake->src[0]->view_src == view_l->view_src &&
+                          view_l->nb[0] == sizeof(float) &&
+                          x_snake->ne[0] == view_l->ne[0] && x_snake->ne[2] == view_l->ne[2] &&
+                          x_snake->ne[3] == 1 && view_l->ne[3] == 1 &&
+                          concat->ne[0] == x_snake->ne[0] &&
+                          concat->ne[1] == x_snake->ne[1] + view_l->ne[1] &&
+                          concat->ne[2] == x_snake->ne[2] &&
+                          alpha->type == GGML_TYPE_F32 && inv_b->type == GGML_TYPE_F32 &&
+                          ggml_is_contiguous(alpha) && ggml_is_contiguous(inv_b) &&
+                          ggml_nelements(alpha) == x_snake->ne[1] &&
+                          ggml_nelements(inv_b) == x_snake->ne[1] &&
+                          ggml_is_contiguous(x_snake) && ggml_is_contiguous(concat);
+    if (!shape_ok) {
+        return 0;
+    }
+    // As below, the allocator planned for the unfused sequence: the output must miss x_snake, and
+    // either miss the parent activation or be exactly it (concat [T, C, B] has the parent's layout,
+    // so every leaky-ReLU element is then read and written at one address).
+    const char * dst_beg = (const char *) concat->data;
+    const char * dst_end = dst_beg + ggml_nbytes(concat);
+    const char * snk_beg = (const char *) x_snake->data;
+    const char * snk_end = snk_beg + ggml_nbytes(x_snake);
+    const ggml_tensor * parent = view_l->view_src;
+    const char * par_beg = (const char *) parent->data;
+    const char * par_end = par_beg + ggml_nbytes(parent);
+    const bool snake_disjoint = snk_end <= dst_beg || dst_end <= snk_beg;
+    const bool parent_disjoint = par_end <= dst_beg || dst_end <= par_beg;
+    const bool parent_inplace = dst_beg == par_beg && dst_end == par_end && ggml_is_contiguous(parent) &&
+                                ggml_are_same_shape(parent, concat);
+    if (!snake_disjoint || !(parent_disjoint || parent_inplace)) {
