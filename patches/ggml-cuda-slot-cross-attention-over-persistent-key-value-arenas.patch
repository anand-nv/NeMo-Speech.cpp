+struct ggml_tensor * ggml_slot_cross_attn(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k_arena,
+        struct ggml_tensor  * v_arena,
+        struct ggml_tensor  * slot_ids,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * kv_lens,
+        int                   n_head,
+        int                   layer,
+        float                 scale,
+        bool                  with_probs) {
+    GGML_ASSERT(q->type == GGML_TYPE_F32 && ggml_is_contiguous(q) && q->ne[2] == 1 && q->ne[3] == 1);
+    const int64_t feat  = q->ne[0];
+    const int64_t batch = q->ne[1];
+    GGML_ASSERT(n_head > 0 && feat % n_head == 0);
+    GGML_ASSERT(k_arena->type == GGML_TYPE_F32 && v_arena->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(k_arena) && ggml_are_same_shape(k_arena, v_arena));
+    GGML_ASSERT(k_arena->ne[0] % feat == 0 && k_arena->ne[3] == 1);
+    GGML_ASSERT(layer >= 0 && layer < k_arena->ne[1]);
+    const int64_t kv_cap = k_arena->ne[0] / feat;
+    GGML_ASSERT(bias->type == GGML_TYPE_F32 && ggml_is_contiguous(bias));
+    GGML_ASSERT(bias->ne[0] == kv_cap && ggml_nrows(bias) == batch);
+    GGML_ASSERT(slot_ids->type == GGML_TYPE_I32 && ggml_is_contiguous(slot_ids) && ggml_nelements(slot_ids) == batch);
+    GGML_ASSERT(kv_lens->type == GGML_TYPE_I32 && ggml_is_contiguous(kv_lens) && ggml_nelements(kv_lens) == batch);
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (feat + kv_cap) * batch);
+    int32_t params[4] = { n_head, layer, 0, with_probs ? 1 : 0 };
+    memcpy(&params[2], &scale, sizeof(float));
+    ggml_set_op_params(result, params, sizeof(params));
+    result->op     = GGML_OP_SLOT_CROSS_ATTN;
+    result->src[0] = q;
+    result->src[1] = k_arena;
+    result->src[2] = v_arena;
+    result->src[3] = slot_ids;
+    result->src[4] = bias;
+    result->src[5] = kv_lens;
+    return result;
+}
+
 struct ggml_tensor * ggml_conv1d_fused(
         struct ggml_context * ctx,
         struct ggml_tensor  * x,
