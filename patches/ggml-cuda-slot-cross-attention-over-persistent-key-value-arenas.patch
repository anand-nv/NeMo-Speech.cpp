diff --git a/ggml/src/ggml-cuda/slot-cross-attn.cu b/ggml/src/ggml-cuda/slot-cross-attn.cu
new file mode 100644
index 0000000000000000000000000000000000000000..fd270ec1a41d0051e6a979fbee8441406ee4eac0
--- /dev/null
+++ b/ggml/src/ggml-cuda/slot-cross-attn.cu
@@ -0,0 +1,208 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+// GGML_OP_SLOT_CROSS_ATTN: one query per batch item attending to the key/value rows of its slot
+// in a persistent arena (see ggml_slot_cross_attn). Reads the arena in place and only the
+// item's kv_lens rows, so no per-step gather or transpose of the cached keys/values is needed.
+#include "slot-cross-attn.cuh"
+
+static constexpr int SLOT_XATTN_WARPS = 16;
+static constexpr int SLOT_XATTN_MAX_DK_PER_LANE = 8;  // d_k <= 256
+
+static __device__ __forceinline__ float slot_xattn_warp_sum(float v) {
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        v += __shfl_xor_sync(0xffffffff, v, offset);
+    }
+    return v;
+}
+
+static __device__ __forceinline__ float slot_xattn_warp_max(float v) {
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        v = fmaxf(v, __shfl_xor_sync(0xffffffff, v, offset));
+    }
+    return v;
+}
+
+// One block per batch item, heads in turn. Shared: scores [kv_cap], probs [kv_cap] (with_probs),
+// per-warp partial contexts [WARPS][d_k], per-warp reductions [WARPS].
+template <int DK_PER_LANE>
+static __global__ void __launch_bounds__(SLOT_XATTN_WARPS * WARP_SIZE)
+slot_cross_attn_kernel(
+        const float * __restrict__ q, const float * __restrict__ k_arena,
+        const float * __restrict__ v_arena, const int32_t * __restrict__ slot_ids,
+        const float * __restrict__ bias, const int32_t * __restrict__ kv_lens,
+        float * __restrict__ dst, const int feat, const int n_head, const int kv_cap,
+        const int batch, const int64_t slot_stride, const int64_t layer_offset, const float scale,
+        const bool with_probs) {
+    constexpr int d_k = DK_PER_LANE * WARP_SIZE;
+    extern __shared__ float smem[];
+    float * scores = smem;
+    float * probs = scores + kv_cap;
+    float * partial = probs + (with_probs ? kv_cap : 0);
+    float * red = partial + SLOT_XATTN_WARPS * d_k;
+
+    const int b = blockIdx.x;
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int len = max(0, min(kv_lens[b], kv_cap));
+    const int64_t base = (int64_t) slot_ids[b] * slot_stride + layer_offset;
+    const float * kb = k_arena + base;
+    const float * vb = v_arena + base;
+    const float * bb = bias + (int64_t) b * kv_cap;
+    float * out = dst + (int64_t) b * feat;
+
+    if (with_probs) {
+        for (int j = threadIdx.x; j < kv_cap; j += blockDim.x) {
+            probs[j] = 0.0f;
+        }
+    }
+
+    for (int h = 0; h < n_head; ++h) {
+        const int hd = h * d_k;
+        float qr[DK_PER_LANE];
+#pragma unroll
+        for (int i = 0; i < DK_PER_LANE; ++i) {
+            qr[i] = q[(int64_t) b * feat + hd + lane + i * WARP_SIZE];
+        }
+
+        // scores = scale * q.k_j + bias_j, one key row per warp at a time
+        float m = -INFINITY;
+        for (int j = warp; j < len; j += SLOT_XATTN_WARPS) {
+            const float * kr = kb + (int64_t) j * feat + hd;
+            float dot = 0.0f;
+#pragma unroll
+            for (int i = 0; i < DK_PER_LANE; ++i) {
+                dot += qr[i] * kr[lane + i * WARP_SIZE];
+            }
+            dot = slot_xattn_warp_sum(dot);
+            const float s = dot * scale + bb[j];
+            if (lane == 0) {
+                scores[j] = s;
+            }
+            m = fmaxf(m, s);
+        }
+        if (lane == 0) {
+            red[warp] = m;
+        }
+        __syncthreads();
+        m = lane < SLOT_XATTN_WARPS ? red[lane] : -INFINITY;
+        m = slot_xattn_warp_max(m);
+        __syncthreads();
+
+        float sum = 0.0f;
+        for (int j = threadIdx.x; j < len; j += blockDim.x) {
+            const float e = expf(scores[j] - m);
+            scores[j] = e;
+            sum += e;
+        }
+        sum = slot_xattn_warp_sum(sum);
+        if (lane == 0) {
+            red[warp] = sum;
+        }
+        __syncthreads();
+        sum = lane < SLOT_XATTN_WARPS ? red[lane] : 0.0f;
+        sum = slot_xattn_warp_sum(sum);
+        const float inv = len > 0 ? 1.0f / sum : 0.0f;
+
+        // context = sum_j p_j v_j: each warp accumulates its rows, then the warps are summed
+        float acc[DK_PER_LANE] = {};
+        for (int j = warp; j < len; j += SLOT_XATTN_WARPS) {
+            const float p = scores[j];
+            const float * vr = vb + (int64_t) j * feat + hd;
+#pragma unroll
+            for (int i = 0; i < DK_PER_LANE; ++i) {
+                acc[i] += p * vr[lane + i * WARP_SIZE];
+            }
+        }
+#pragma unroll
+        for (int i = 0; i < DK_PER_LANE; ++i) {
+            partial[warp * d_k + lane + i * WARP_SIZE] = acc[i];
+        }
+        __syncthreads();
+        for (int d = threadIdx.x; d < d_k; d += blockDim.x) {
+            float c = 0.0f;
+#pragma unroll
+            for (int w = 0; w < SLOT_XATTN_WARPS; ++w) {
+                c += partial[w * d_k + d];
+            }
+            out[hd + d] = c * inv;
+        }
+        if (with_probs) {
+            for (int j = threadIdx.x; j < len; j += blockDim.x) {
+                probs[j] += scores[j] * inv;
+            }
+        }
+        __syncthreads();
+    }
+
+    if (with_probs) {
+        float * pout = dst + (int64_t) feat * batch + (int64_t) b * kv_cap;
+        for (int j = threadIdx.x; j < kv_cap; j += blockDim.x) {
+            pout[j] = probs[j];
+        }
+    }
+}
+
+static size_t slot_cross_attn_shmem(int kv_cap, int d_k, bool with_probs) {
+    return ((size_t) kv_cap * (with_probs ? 2 : 1) + (size_t) SLOT_XATTN_WARPS * d_k +
+            SLOT_XATTN_WARPS) * sizeof(float);
+}
+
+bool ggml_cuda_slot_cross_attn_supported(const ggml_tensor * op) {
+    const int n_head = ggml_get_op_params_i32(op, 0);
+    const int64_t feat = op->src[0]->ne[0];
+    if (n_head <= 0 || feat % n_head != 0) {
+        return false;
+    }
+    const int64_t d_k = feat / n_head;
+    const int64_t per_lane = d_k / WARP_SIZE;
+    if (d_k % WARP_SIZE != 0 || per_lane > SLOT_XATTN_MAX_DK_PER_LANE || (per_lane & (per_lane - 1)) != 0) {
+        return false;
+    }
+    const int kv_cap = (int) (op->src[1]->ne[0] / feat);
+    return slot_cross_attn_shmem(kv_cap, (int) d_k, ggml_get_op_params_i32(op, 3) != 0) <= 48 * 1024;
+}
+
+void ggml_cuda_op_slot_cross_attn(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * q        = dst->src[0];
+    const ggml_tensor * k_arena  = dst->src[1];
+    const ggml_tensor * v_arena  = dst->src[2];
+    const ggml_tensor * slot_ids = dst->src[3];
+    const ggml_tensor * bias     = dst->src[4];
+    const ggml_tensor * kv_lens  = dst->src[5];
+    GGML_ASSERT(ggml_cuda_slot_cross_attn_supported(dst));
+
+    const int n_head = ggml_get_op_params_i32(dst, 0);
+    const int layer = ggml_get_op_params_i32(dst, 1);
+    float scale;
+    memcpy(&scale, (const int32_t *) dst->op_params + 2, sizeof(float));
+    const bool with_probs = ggml_get_op_params_i32(dst, 3) != 0;
+
+    const int feat = (int) q->ne[0];
+    const int batch = (int) q->ne[1];
+    const int d_k = feat / n_head;
+    const int kv_cap = (int) (k_arena->ne[0] / feat);
+    const int64_t layer_offset = (int64_t) layer * (int64_t) (k_arena->nb[1] / sizeof(float));
+    const int64_t slot_stride = (int64_t) (k_arena->nb[2] / sizeof(float));
+
+    cudaStream_t stream = ctx.stream();
+    const size_t shmem = slot_cross_attn_shmem(kv_cap, d_k, with_probs);
+    const dim3 grid(batch);
+    const dim3 block(SLOT_XATTN_WARPS * WARP_SIZE);
+    auto launch = [&](auto kernel) {
+        kernel<<<grid, block, shmem, stream>>>(
+            (const float *) q->data, (const float *) k_arena->data, (const float *) v_arena->data,
+            (const int32_t *) slot_ids->data, (const float *) bias->data,
+            (const int32_t *) kv_lens->data, (float *) dst->data, feat, n_head, kv_cap, batch,
+            slot_stride, layer_offset, scale, with_probs);
+    };
+    switch (d_k / WARP_SIZE) {
+        case 1: launch(slot_cross_attn_kernel<1>); break;
+        case 2: launch(slot_cross_attn_kernel<2>); break;
+        case 4: launch(slot_cross_attn_kernel<4>); break;
+        case 8: launch(slot_cross_attn_kernel<8>); break;
+        default: GGML_ABORT("slot_cross_attn: unsupported d_k %d", d_k);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
